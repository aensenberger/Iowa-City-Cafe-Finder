
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <meta name="description" content="Find your perfect Iowa City study cafe. Explore coffee spots for studying, laptop work, group projects, and quiet study sessions.">

  <title>Iowa City Cafe Finder | Coffee, Study & Hawkeye Life</title>

  <style>
    :root {
      --coffee: #493125;
      --espresso: #30221c;
      --cream: #fff8ed;
      --latte: #f0dfc9;
      --caramel: #c68b52;
      --gold: #ffcd45;
      --green: #596b4e;
      --text: #33271f;
      --white: #ffffff;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: "Trebuchet MS", Arial, sans-serif;
      background: var(--cream);
      color: var(--text);
      line-height: 1.7;
    }

    a {
      transition: 0.2s ease;
    }

    .notice {
      background: #f3e6d5;
      padding: 10px 5%;
      text-align: center;
      font-size: 0.8rem;
      line-height: 1.5;
    }

    header {
      background: var(--espresso);
      color: white;
      padding: 20px 6%;
    }

    .header-inner {
      max-width: 1150px;
      margin: auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 14px;
    }

    .brand {
      color: white;
      font-size: 1.35rem;
      font-weight: 900;
      letter-spacing: -0.5px;
    }

    .brand span {
      color: var(--gold);
    }

    nav {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 20px;
    }

    nav a {
      color: white;
      font-size: 0.9rem;
      font-weight: bold;
      text-decoration: none;
    }

    nav a:hover,
    nav a:focus {
      color: var(--gold);
    }

    /* HERO */

    .hero {
      background:
        radial-gradient(ellipse at 90% 10%, #79513b 0, transparent 36%),
        linear-gradient(125deg, #30221c, #604331 65%, #815b40);
      color: white;
      overflow: hidden;
    }

    .hero-inner {
      max-width: 1150px;
      min-height: 460px;
      margin: auto;
      padding: 65px 6%;
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 35px;
      align-items: center;
    }

    .eyebrow {
      display: inline-block;
      background: var(--gold);
      color: var(--espresso);
      padding: 6px 13px;
      border-radius: 50px;
      font-size: 0.76rem;
      font-weight: 900;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .hero h1 {
      color: white;
      font-size: clamp(2.5rem, 5vw, 4.6rem);
      letter-spacing: -2px;
      line-height: 1.08;
      margin: 20px 0;
    }

    .hero h1 span {
      color: var(--gold);
    }

    .hero p {
      max-width: 520px;
      color: #f7e9da;
      font-size: 1.05rem;
    }

    .hero-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 25px;
    }

    .button {
      display: inline-block;
      padding: 12px 19px;
      border-radius: 8px;
      font-weight: bold;
      text-decoration: none;
    }

    .button-primary {
      background: var(--gold);
      color: var(--espresso);
    }

    .button-primary:hover {
      background: white;
      transform: translateY(-2px);
    }

    .button-secondary {
      border: 1px solid #e8d7c3;
      color: white;
    }

    .button-secondary:hover {
      background: rgba(255,255,255,0.12);
    }

    /* DECORATIVE COFFEE ILLUSTRATION */

    .coffee-art {
      min-height: 310px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .sun {
      position: absolute;
      width: 255px;
      height: 255px;
      background: var(--caramel);
      border-radius: 50%;
      opacity: 0.7;
    }

    .coffee-cup {
      position: relative;
      z-index: 1;
      width: 200px;
      height: 155px;
      background: #fff8ed;
      border-radius: 20px 20px 70px 70px;
      border: 7px solid #e8d7c3;
      box-shadow: 12px 20px 0 rgba(0,0,0,0.14);
      transform: rotate(-7deg);
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .coffee-cup::before {
      content: "";
      position: absolute;
      width: 53px;
      height: 58px;
      border: 13px solid #e8d7c3;
      border-left: 0;
      border-radius: 0 28px 28px 0;
      right: -53px;
      top: 32px;
    }

    .latte {
      width: 100px;
      height: 100px;
      background: #bb8050;
      border: 7px solid #f5e5d1;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3rem;
    }

    .floating {
      position: absolute;
      z-index: 2;
      background: white;
      color: var(--coffee);
      padding: 10px 15px;
      border-radius: 12px;
      box-shadow: 0 7px 22px rgba(0,0,0,0.15);
      font-size: 0.88rem;
      font-weight: bold;
    }

    .float-one {
      top: 30px;
      left: 0;
      transform: rotate(-5deg);
    }

    .float-two {
      bottom: 25px;
      right: 0;
      transform: rotate(4deg);
    }

    /* QUICK STUDY MOODS */

    .mood-section {
      max-width: 1150px;
      margin: auto;
      padding: 32px 6%;
    }

    .mood-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }

    .mood {
      text-decoration: none;
      color: var(--coffee);
      background: white;
      border: 1px solid var(--latte);
      padding: 18px 12px;
      text-align: center;
      border-radius: 13px;
      font-weight: bold;
    }

    .mood:hover {
      background: var(--latte);
      transform: translateY(-3px);
    }

    .mood .emoji {
      display: block;
      font-size: 1.8rem;
      margin-bottom: 5px;
    }

    /* MAIN SECTIONS */

    main {
      max-width: 1150px;
      margin: auto;
      padding: 15px 6% 55px;
    }

    .section-heading {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 15px;
      flex-wrap: wrap;
      margin: 30px 0 22px;
    }

    .section-heading h2 {
      font-size: clamp(1.7rem, 3vw, 2.5rem);
      color: var(--coffee);
      margin: 0;
      letter-spacing: -0.8px;
      line-height: 1.2;
    }

    .section-heading p {
      margin: 7px 0 0;
      color: #756457;
    }

    .text-link {
      color: var(--green);
      font-weight: bold;
      text-decoration: none;
    }

    .text-link:hover {
      text-decoration: underline;
    }

    /* CAFE CARDS */

    .cafe-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }

    .cafe-card {
      background: white;
      border: 1px solid #ebddcb;
      border-radius: 16px;
      overflow: hidden;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .cafe-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 25px rgba(73,49,37,0.10);
    }

    .cafe-art {
      min-height: 155px;
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 4rem;
    }

    .art-one {
      background: #e8d6bc;
    }

    .art-two {
      background: #d9e0cc;
    }

    .art-three {
      background: #f1d8c8;
    }

    .cafe-content {
      padding: 20px;
    }

    .pill {
      display: inline-block;
      background: #edf0e7;
      color: #40543b;
      border-radius: 30px;
      padding: 4px 10px;
      font-size: 0.73rem;
      font-weight: bold;
    }

    .cafe-content h3 {
      color: var(--coffee);
      font-size: 1.3rem;
      margin: 12px 0 6px;
    }

    .cafe-content p {
      font-size: 0.94rem;
      margin: 0 0 15px;
    }

    .cafe-content a {
      color: var(--green);
      font-weight: bold;
      text-decoration: none;
    }

    .cafe-content a:hover {
      text-decoration: underline;
    }

    .fictional-note {
      color: #756457;
      font-size: 0.83rem;
      margin-top: 15px;
    }

    /* STUDENT FEATURE STRIP */

    .feature {
      background: var(--latte);
      border-radius: 18px;
      padding: 32px;
      margin-top: 42px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 28px;
    }

    .feature h2 {
      color: var(--coffee);
      font-size: 2rem;
      line-height: 1.2;
      margin: 12px 0;
    }

    .feature p {
      margin-bottom: 20px;
    }

    .feature-art {
      min-height: 200px;
      border-radius: 14px;
      background: #d8c0a2;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: clamp(4rem, 10vw, 7rem);
    }

    /* FOOTER */

    footer {
      background: var(--espresso);
      color: #fff8ed;
      padding: 35px 6%;
      text-align: center;
    }

    footer strong {
      color: var(--gold);
      font-size: 1.2rem;
    }

    footer a {
      color: white;
      text-decoration: none;
    }

    footer a:hover {
      color: var(--gold);
      text-decoration: underline;
    }

    .footer-links {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px 22px;
      margin: 15px 0;
    }

    footer .notice {
      background: transparent;
      padding: 15px 0 0;
      font-size: 0.8rem;
      overflow-wrap: anywhere;
    }

    @media (max-width: 760px) {
      .hero-inner {
        grid-template-columns: 1fr;
        padding-top: 45px;
        padding-bottom: 35px;
      }

      .coffee-art {
        min-height: 260px;
      }

      .sun {
        width: 205px;
        height: 205px;
      }

      .coffee-cup {
        transform: scale(0.85) rotate(-7deg);
      }

      .float-one {
        left: 5%;
      }

      .float-two {
        right: 3%;
      }

      .mood-row {
        grid-template-columns: repeat(2, 1fr);
      }

      .cafe-grid {
        grid-template-columns: 1fr;
      }

      .cafe-art {
        min-height: 130px;
      }

      .feature {
        grid-template-columns: 1fr;
        padding: 23px;
      }

      .header-inner {
        align-items: flex-start;
        flex-direction: column;
      }
    }

    @media (max-width: 400px) {
      nav {
        gap: 9px 14px;
      }

      nav a {
        font-size: 0.82rem;
      }

      .hero h1 {
        letter-spacing: -1px;
      }

      .mood {
        font-size: 0.85rem;
      }
    }
  </style>
</head>

